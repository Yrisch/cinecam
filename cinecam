#!/usr/bin/env bash
# cinecam: camera paths through SPH simulations, rendered with shamrock
# Copyright (c) 2026 the cinecam authors
# SPDX-License-Identifier: CECILL-2.1
# cinecam is licensed under the CeCILL 2.1 License, see LICENSE for more information
# cinecam launcher
#   ./cinecam [dumps ...] [--path campath.json]     camera path editor
#   ./cinecam render campath.json [options]         batch movie render
#   ./cinecam test [pytest options]                 run the tests (tests/)
# Environment (see README.md, "Installation"):
#   CINECAM_PYTHON   python interpreter to use (default: python3 on PATH, e.g. the active venv)
#   SHAMROCK_BUILD   shamrock build directory holding pysham/ (default: ../../build)
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SHAMROCK_BUILD="${SHAMROCK_BUILD:-$HERE/../../build}"
PY="${CINECAM_PYTHON:-python3}"
if [ ! -d "$SHAMROCK_BUILD/pysham" ]; then
    echo "cinecam: no shamrock python module in $SHAMROCK_BUILD/pysham;" \
         "set SHAMROCK_BUILD to your shamrock build directory" >&2
    exit 1
fi
export PYTHONPATH="$HERE/src:$SHAMROCK_BUILD/pysham${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$SHAMROCK_BUILD${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ "$1" = "render" ]; then
    shift
    exec "$PY" -m cinecam.render_movie "$@"
fi
if [ "$1" = "test" ]; then
    shift
    cd "$HERE" && exec "$PY" -m pytest "$@"
fi
exec "$PY" -m cinecam.gui.app "$@"
